{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/forfaits", "destination": "/forfaits.html" },
    { "source": "/forfaits-cyber", "destination": "/forfaits-cyber.html" },
    { "source": "/centre-indar", "destination": "/centre-indar.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/app", "destination": "/pro.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
