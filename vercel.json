{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/abonnement", "destination": "/abonnement.html" },
    { "source": "/midas", "destination": "/midas.html" },
    { "source": "/midas-finance", "destination": "/midas-finance.html" },
    { "source": "/forfaits", "destination": "/forfaits.html" },
    { "source": "/forfaits-cyber", "destination": "/forfaits-cyber.html" },
    { "source": "/centre-indar", "destination": "/centre-indar.html" },
    { "source": "/bourse", "destination": "/bourse.html" },
    { "source": "/codex", "destination": "/tilexcode.html" },
    { "source": "/tilexcode", "destination": "/tilexcode.html" },
    { "source": "/truck", "destination": "/truck.html" },
    { "source": "/truck-map", "destination": "/truck-map.html" },
    { "source": "/suivi", "destination": "/truck-map.html" },
    { "source": "/maison", "destination": "/maison.html" },
    { "source": "/rapport", "destination": "/rapport.html" },
    { "source": "/systeme", "destination": "/systeme.html" },
    { "source": "/agenda", "destination": "/agenda.html" },
    { "source": "/comm", "destination": "/comm/index.html" },
    { "source": "/communications", "destination": "/communications.html" },
    { "source": "/projets", "destination": "/projets.html" },
    { "source": "/schema", "destination": "/schema.html" },
    { "source": "/web", "destination": "/web.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/pro", "destination": "/pro.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/app", "destination": "/pro.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://rnuripmfozlxenryxhdc.supabase.co wss://rnuripmfozlxenryxhdc.supabase.co https://api.github.com https://api.coingecko.com https://esm.sh https://api.open-meteo.com https://*.wikipedia.org https://commons.wikimedia.org https://www.googleapis.com https://api.unsplash.com https://api.pexels.com https://pixabay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
