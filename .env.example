# ============================================================
# ti-lex-AL v10 — variables d'environnement (exemple)
# Copie ce fichier en .env.local et remplis les vraies valeurs.
# NE JAMAIS committer le .env.local avec de vraies clés.
# ============================================================

# Supabase (front statique — clé publishable seulement)
SUPABASE_URL=https://rnuripmfozlxenryxhdc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clé API Anthropic — UNIQUEMENT côté serveur / Edge Function en production.
# En dev local tu peux la coller dans Paramètres de l'app (stockée en localStorage).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Modèle par défaut d'Agent AL
TILEX_DEFAULT_MODEL=claude-opus-4-8
