# ══════════════════════════════════════════════════════════════════════════════
# TI-LEX-AL V10 — Variables d'environnement
# Projet : ceauprevost812-3889s-projects.vercel.app
# Supabase Project ID : rnuripmfozlxenryxhdc
#
# INSTRUCTIONS :
#   1. Copie ce fichier et renomme-le ".env.local" pour développement local
#   2. Dans Vercel → Settings → Environment Variables, entre chaque paire NOM=valeur
#   3. Dans Supabase → Authentication → Providers, configure Google et GitHub
#   4. Ne commite JAMAIS le fichier .env.local dans Git — ajoute-le dans .gitignore
#
# LÉGENDE :
#   [PUBLIC]  → Peut aller dans le frontend (safe à exposer)
#   [PRIVÉ]   → Côté serveur uniquement — jamais dans le browser
#   [SUPABASE]→ À coller aussi dans Supabase Auth → Providers
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — Core
# Source : https://supabase.com/dashboard/project/rnuripmfozlxenryxhdc/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# [PUBLIC] URL de ton projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://rnuripmfozlxenryxhdc.supabase.co

# [PUBLIC] Clé anonyme — safe côté client, protégée par Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REMPLACE_PAR_TON_ANON_KEY

# [PRIVÉ] Clé service_role — accès admin total, JAMAIS dans le frontend
SUPABASE_SERVICE_ROLE_KEY=REMPLACE_PAR_TON_SERVICE_ROLE_KEY


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH (= Google + Gmail — même provider)
# Source : https://console.cloud.google.com/apis/credentials
# À entrer aussi dans : Supabase → Auth → Providers → Google
# ─────────────────────────────────────────────────────────────────────────────

# [PUBLIC] Identifiant public de ton app Google
# Format : xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REMPLACE_PAR_TON_GOOGLE_CLIENT_ID

# [PRIVÉ] [SUPABASE] Secret Google — uniquement dans Supabase Auth Providers
# Ne pas exposer dans le frontend
GOOGLE_CLIENT_SECRET=REMPLACE_PAR_TON_GOOGLE_CLIENT_SECRET


# ─────────────────────────────────────────────────────────────────────────────
# GITHUB OAUTH
# Source : https://github.com/settings/developers → OAuth Apps → ton app
# À entrer aussi dans : Supabase → Auth → Providers → GitHub
# ─────────────────────────────────────────────────────────────────────────────

# [PUBLIC] Identifiant public de ton app GitHub OAuth
# Format : Iv1.xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GITHUB_CLIENT_ID=REMPLACE_PAR_TON_GITHUB_CLIENT_ID

# [PRIVÉ] [SUPABASE] Secret GitHub — uniquement dans Supabase Auth Providers
GITHUB_CLIENT_SECRET=REMPLACE_PAR_TON_GITHUB_CLIENT_SECRET


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION — URLs de redirection
# ─────────────────────────────────────────────────────────────────────────────

# [PUBLIC] URL publique de ton app en production (sans slash final)
NEXT_PUBLIC_APP_URL=https://ceauprevost812-3889s-projects.vercel.app

# [PUBLIC] Page de redirection après connexion réussie
NEXT_PUBLIC_REDIRECT_URL=https://ceauprevost812-3889s-projects.vercel.app/dashboard

# [PUBLIC] Environnement actuel (development | preview | production)
NEXT_PUBLIC_ENV=production


# ─────────────────────────────────────────────────────────────────────────────
# VERCEL (auto-injectées par Vercel — NE PAS MODIFIER)
# Ces variables sont remplies automatiquement par Vercel lors du déploiement
# ─────────────────────────────────────────────────────────────────────────────

# VERCEL_URL=ceauprevost812-3889s-projects.vercel.app   ← injectée auto
# VERCEL_ENV=production                                   ← injectée auto
# VERCEL_GIT_COMMIT_SHA=xxxxxxx                          ← injectée auto


# ─────────────────────────────────────────────────────────────────────────────
# FMP — Financial Modeling Prep (données boursières)
# Source : https://site.financialmodelingprep.com/developer/docs
# Utilisée par :
#   - le proxy navigateur /api/fmp-proxy (api/fmp-proxy.js)        → secret VERCEL
#   - l'outil boursier de l'agent AL (Edge Function ai-proxy)     → secret SUPABASE
# À définir DANS LES DEUX si tu veux les deux usages.
# ─────────────────────────────────────────────────────────────────────────────

# [PRIVÉ] Clé FMP — côté serveur uniquement, JAMAIS dans le frontend
FMP_API_KEY=REMPLACE_PAR_TA_CLE_FMP


# ══════════════════════════════════════════════════════════════════════════════
